{
  "tool": "Kubernetes",
  "auth": "kubeconfig with a read-only ServiceAccount bound to a cluster-scoped view/audit ClusterRole; token minted via TokenRequest (short-lived, audience-bound). On managed clusters authenticate through the cloud identity mapped into Kubernetes RBAC: EKS 'aws eks get-token' (aws-auth ConfigMap / access entries), AKS 'kubelogin' with Entra ID, GKE 'gke-gcloud-auth-plugin' with Google OIDC. x509 client certificates signed by the cluster CA are the fallback for self-managed (kubeadm) clusters.",
  "base_url": "https://<CLUSTER_ID>.<region>.eks.amazonaws.com  (EKS) / https://<host>:6443 (self-managed)",
  "endpoints": [
    {
      "method": "GET",
      "path": "/apis/apps/v1/deployments",
      "purpose": "Inventory declared workloads (Deployments; also statefulsets/daemonsets) with images and replicas (ID.AM-02)."
    },
    {
      "method": "GET",
      "path": "/api/v1/pods",
      "purpose": "List running pods - the actual executed images, serviceAccount bindings, and node placement (ID.AM-02)."
    },
    {
      "method": "GET",
      "path": "/api/v1/serviceaccounts",
      "purpose": "Inventory workload identities and automountServiceAccountToken posture (PR.AA-01)."
    },
    {
      "method": "POST",
      "path": "/apis/authentication.k8s.io/v1/tokenreviews",
      "purpose": "Validate a bearer token against the configured authenticators (OIDC, x509, webhook) and return the resolved user/groups (PR.AA-03)."
    },
    {
      "method": "GET",
      "path": "/apis/rbac.authorization.k8s.io/v1/clusterrolebindings",
      "purpose": "Review cluster-wide RBAC bindings for least privilege (who holds cluster-admin etc.) (PR.AA-05)."
    },
    {
      "method": "GET",
      "path": "/apis/rbac.authorization.k8s.io/v1/clusterroles",
      "purpose": "Review aggregated ClusterRole rules for wildcard verbs/resources and separation of duties (PR.AA-05)."
    },
    {
      "method": "GET",
      "path": "/api/v1/namespaces/kube-system/pods",
      "purpose": "Read kube-apiserver static-pod manifest flags: --encryption-provider-config, --audit-policy-file, --audit-log-path, --oidc-issuer-url (PR.DS-01, PR.PS-04, PR.AA-03)."
    },
    {
      "method": "GET",
      "path": "/api/v1/namespaces",
      "purpose": "Read pod-security.kubernetes.io/enforce|audit|warn labels enforcing Pod Security Standards per namespace (PR.PS-05)."
    },
    {
      "method": "GET",
      "path": "/apis/admissionregistration.k8s.io/v1/validatingadmissionpolicies",
      "purpose": "List in-tree ValidatingAdmissionPolicies (CEL) blocking unauthorized workload specs at admission (PR.PS-05)."
    },
    {
      "method": "GET",
      "path": "/apis/networking.k8s.io/v1/networkpolicies",
      "purpose": "Read pod ingress/egress segmentation rules and incident-time quarantine policies (PR.IR-01, RS.MI-01)."
    },
    {
      "method": "GET",
      "path": "/apis/policy/v1/poddisruptionbudgets",
      "purpose": "Verify availability guardrails (minAvailable/maxUnavailable) for voluntary disruptions (PR.IR-03)."
    },
    {
      "method": "GET",
      "path": "/apis/autoscaling/v2/horizontalpodautoscalers",
      "purpose": "Verify autoscaling policies that maintain capacity under load (PR.IR-04)."
    },
    {
      "method": "GET",
      "path": "/apis/aquasecurity.github.io/v1alpha1/vulnerabilityreports",
      "purpose": "Trivy Operator in-cluster image vulnerability reports per workload/container (ID.RA-01)."
    },
    {
      "method": "GET",
      "path": "/apis/aquasecurity.github.io/v1alpha1/sbomreports",
      "purpose": "Trivy Operator per-workload CycloneDX SBOMs for software supply-chain monitoring (GV.SC-09)."
    },
    {
      "method": "GET",
      "path": "/apis/kyverno.io/v1/clusterpolicies",
      "purpose": "Kyverno policies enforcing cosign signature/SLSA-attestation verification of images before admission (ID.RA-09)."
    },
    {
      "method": "GET",
      "path": "/apis/velero.io/v1/schedules",
      "purpose": "Velero backup schedules - cadence, TTL, included namespaces, snapshotVolumes (RC.RP-03)."
    },
    {
      "method": "GET",
      "path": "/apis/velero.io/v1/backups",
      "purpose": "Velero backup records - phase, formatVersion, expiration, errors - integrity of restoration assets (RC.RP-03)."
    },
    {
      "method": "GET",
      "path": "/apis/velero.io/v1/restores",
      "purpose": "Velero restore records - recovery execution, phase Completed, warnings (RC.RP-01)."
    }
  ],
  "controls": [
    {
      "ref": "ID.AM-02",
      "api": "kubectl get deployments,statefulsets,daemonsets -A -o json",
      "fields": [
        "items[].metadata.namespace",
        "items[].metadata.name",
        "items[].metadata.labels.app",
        "items[].spec.replicas",
        "items[].spec.template.spec.containers[].image"
      ],
      "sample": {
        "metadata": {
          "namespace": "payments",
          "name": "payments-api",
          "labels": {
            "app": "payments-api",
            "team": "payments"
          }
        },
        "spec": {
          "replicas": 3,
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "api",
                  "image": "registry.acme.com/payments-api:2.14.1@sha256:9f2c1d3e5a7b9c0d1e2f3a4b5c6d7e8f90a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6"
                }
              ]
            }
          }
        }
      }
    },
    {
      "ref": "ID.RA-01",
      "api": "kubectl get vulnerabilityreports.aquasecurity.github.io -A -o json  (Trivy Operator)",
      "fields": [
        "metadata.labels['trivy-operator.resource.name']",
        "report.artifact.repository",
        "report.artifact.tag",
        "report.summary.criticalCount",
        "report.vulnerabilities[].vulnerabilityID",
        "report.vulnerabilities[].fixedVersion"
      ],
      "sample": {
        "metadata": {
          "namespace": "payments",
          "labels": {
            "trivy-operator.resource.kind": "Deployment",
            "trivy-operator.resource.name": "payments-api"
          }
        },
        "report": {
          "artifact": {
            "repository": "registry.acme.com/payments-api",
            "tag": "2.14.1"
          },
          "summary": {
            "criticalCount": 0,
            "highCount": 2,
            "mediumCount": 11
          },
          "vulnerabilities": [
            {
              "vulnerabilityID": "CVE-2025-22868",
              "severity": "HIGH",
              "fixedVersion": "0.35.0",
              "installedVersion": "0.31.0"
            }
          ]
        }
      }
    },
    {
      "ref": "ID.RA-09",
      "api": "kubectl get clusterpolicies.kyverno.io verify-image-signatures -o json",
      "fields": [
        "spec.rules[].verifyImages[].imageReferences",
        "spec.rules[].verifyImages[].attestors[].entries[].keys",
        "spec.rules[].verifyImages[].attestations[].predicateType",
        "spec.validationFailureAction",
        "status.ready"
      ],
      "sample": {
        "metadata": {
          "name": "verify-image-signatures"
        },
        "spec": {
          "validationFailureAction": "Enforce",
          "rules": [
            {
              "name": "require-cosign-signature-and-slsa",
              "verifyImages": [
                {
                  "imageReferences": [
                    "registry.acme.com/*"
                  ],
                  "attestors": [
                    {
                      "entries": [
                        {
                          "keys": {
                            "publicKeys": "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...\n-----END PUBLIC KEY-----",
                            "rekor": {
                              "url": "https://rekor.sigstore.dev"
                            }
                          }
                        }
                      ]
                    }
                  ],
                  "attestations": [
                    {
                      "predicateType": "https://slsa.dev/provenance/v1",
                      "conditions": [
                        {
                          "all": [
                            {
                              "key": "{{ builder.id }}",
                              "operator": "Equals",
                              "value": "https://github.com/acme/.github/workflows/release.yaml"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "status": {
          "ready": true
        }
      }
    },
    {
      "ref": "GV.SC-09",
      "api": "kubectl get sbomreports.aquasecurity.github.io -A -o json  (Trivy Operator CycloneDX SBOM per workload)",
      "fields": [
        "report.artifact.repository",
        "report.artifact.digest",
        "report.components.bomFormat",
        "report.components.specVersion",
        "report.summary.componentsCount"
      ],
      "sample": {
        "metadata": {
          "namespace": "payments",
          "labels": {
            "trivy-operator.resource.name": "payments-api"
          }
        },
        "report": {
          "artifact": {
            "repository": "registry.acme.com/payments-api",
            "digest": "sha256:9f2c1d3e5a7b9c0d1e2f3a4b5c6d7e8f90a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6"
          },
          "components": {
            "bomFormat": "CycloneDX",
            "specVersion": "1.6",
            "components": [
              {
                "type": "library",
                "name": "golang.org/x/crypto",
                "version": "v0.31.0"
              }
            ]
          },
          "summary": {
            "componentsCount": 184
          }
        }
      }
    },

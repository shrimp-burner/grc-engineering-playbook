{
  "_meta": {
    "operators": [
      "eq",
      "neq",
      "lt",
      "lte",
      "gt",
      "gte",
      "not_null",
      "in",
      "contains",
      "max_field_lt"
    ]
  },
  "controls": [
    {
      "id": "GR-S3-001",
      "title": "S3 buckets must have server-side encryption",
      "framework": "SOC2",
      "ref": "CC6.1",
      "owner": "cloud-security",
      "severity": "critical",
      "resource": "s3_buckets",
      "filters": [],
      "conditions": [
        {
          "path": "encryption.enabled",
          "op": "eq",
          "value": true
        }
      ],
      "mappings": [
        {
          "framework": "SOC2",
          "ref": "CC6.1"
        },
        {
          "framework": "ISO27001",
          "ref": "A.8.24"
        },
        {
          "framework": "NIST-CSF-2.0",
          "ref": "PR.DS-01"
        }
      ]
    },
    {
      "id": "GR-S3-002",
      "title": "S3 buckets must not be publicly accessible via ACL",
      "framework": "SOC2",
      "ref": "CC6.1",
      "owner": "cloud-security",
      "severity": "critical",
      "resource": "s3_buckets",
      "filters": [],
      "conditions": [
        {
          "path": "public_access.acl_public",
          "op": "eq",
          "value": false
        }
      ],
      "mappings": [
        {
          "framework": "SOC2",
          "ref": "CC6.1"
        },
        {
          "framework": "ISO27001",
          "ref": "A.5.15"
        }
      ]
    },
    {
      "id": "GR-S3-003",
      "title": "S3 buckets must have access logging configured",
      "framework": "ISO27001",
      "ref": "A.8.15",
      "owner": "cloud-security",
      "severity": "high",
      "resource": "s3_buckets",
      "filters": [],
      "conditions": [
        {
          "path": "logging_target",
          "op": "not_null"
        }
      ],
      "mappings": [
        {
          "framework": "ISO27001",
          "ref": "A.8.15"
        },
        {
          "framework": "NIST-CSF-2.0",
          "ref": "PR.PS-04"
        }
      ]
    },
    {
      "id": "GR-S3-004",
      "title": "S3 buckets must have versioning enabled",
      "framework": "ISO27001",
      "ref": "A.8.13",
      "owner": "platform",
      "severity": "medium",
      "resource": "s3_buckets",
      "filters": [],
      "conditions": [
        {
          "path": "versioning",
          "op": "eq",
          "value": true
        }
      ],
      "mappings": [
        {
          "framework": "ISO27001",
          "ref": "A.8.13"
        },
        {
          "framework": "NIST-CSF-2.0",
          "ref": "PR.PS-01"
        }
      ]
    },
    {
      "id": "GR-S3-005",
      "title": "S3 buckets must enable block_public_acls",
      "framework": "ISO27001",
      "ref": "A.8.15",
      "owner": "cloud-security",
      "severity": "high",
      "resource": "s3_buckets",
      "filters": [],
      "conditions": [
        {
          "path": "public_access.block_public_acls",
          "op": "eq",
          "value": true
        }
      ],
      "mappings": [
        {
          "framework": "ISO27001",
          "ref": "A.5.15"
        }
      ]
    },
    {
      "id": "GR-IAM-001",
      "title": "Users with console access must have MFA active",
      "framework": "SOC2",
      "ref": "CC6.1",
      "owner": "identity",
      "severity": "critical",
      "resource": "iam_users",
      "filters": [
        {
          "path": "console_access",
          "op": "eq",
          "value": true
        }
      ],
      "conditions": [
        {
          "path": "mfa_active",
          "op": "eq",
          "value": true
        }
      ],
      "mappings": [
        {
          "framework": "SOC2",
          "ref": "CC6.1"
        },
        {
          "framework": "ISO27001",
          "ref": "A.8.5"
        },
        {
          "framework": "NIST-CSF-2.0",
          "ref": "PR.AA-03"
        }
      ]
    },
    {
      "id": "GR-IAM-002",
      "title": "No access key older than 90 days",
      "framework": "SOC2",
      "ref": "CC6.1",
      "owner": "identity",
      "severity": "high",
      "resource": "iam_users",
      "filters": [],
      "conditions": [
        {
          "op": "max_field_lt",
          "path": "access_keys",
          "field": "age_days",
          "value": 90
        }
      ],
      "mappings": [
        {
          "framework": "SOC2",
          "ref": "CC6.1"
        },
        {
          "framework": "ISO27001",
          "ref": "A.8.5"
        },
        {
          "framework": "NIST-CSF-2.0",
          "ref": "PR.AA-01"
        }
      ]
    },
